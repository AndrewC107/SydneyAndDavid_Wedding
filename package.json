{
  "name": "sydney-david-wedding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "convex:dev": "node --use-system-ca ./node_modules/convex/bin/main.js dev",
    "convex:deploy": "node --use-system-ca ./node_modules/convex/bin/main.js deploy",
    "convex:push": "node --use-system-ca ./node_modules/convex/bin/main.js dev --once"
  },
  "dependencies": {
    "convex": "^1.45.0",
    "next": "^16.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.7",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
