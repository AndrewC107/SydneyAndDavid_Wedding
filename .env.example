# Convex (required for RSVP storage)
NEXT_PUBLIC_CONVEX_URL=https://watchful-chihuahua-406.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://watchful-chihuahua-406.convex.site

