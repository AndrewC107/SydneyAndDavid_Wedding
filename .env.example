# Convex (required for RSVP storage)
# After changing this on Vercel, trigger a new deployment — Next.js
# bakes NEXT_PUBLIC_* variables into the build at deploy time.
NEXT_PUBLIC_CONVEX_URL=https://first-clownfish-969.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://first-clownfish-969.convex.site

# Set after linking this repo to your Convex project:
# CONVEX_DEPLOYMENT=dev:first-clownfish-969

# Optional: deploy from CI without login (Convex Dashboard → Settings → Deploy Key)
# CONVEX_DEPLOY_KEY=
